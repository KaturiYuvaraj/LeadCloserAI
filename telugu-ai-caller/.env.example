# ===================================================================
# Application Environment & Security
# ===================================================================
# development | production | test
APP_ENV=development
# Cryptographic secret for signing JWT tokens (REQUIRED in production):
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_strong_random_signing_key_here
# Enforce mandatory JWT authentication across all endpoints:
AUTH_STRICT=false

# ===================================================================
# Sarvam AI API Configuration (Voice STT, TTS & Indic LLM)
# Get your key at: https://sarvam.ai
# ===================================================================
SARVAM_API_KEY=your_sarvam_api_key_here

# ===================================================================
# Active Carrier Telephony — Vobiz (Indian PSTN Calling)
# Console: https://console.vobiz.ai -> API Credentials & Phone Numbers
# ===================================================================
DIALER_PROVIDER=vobiz
VOBIZ_AUTH_ID=your_vobiz_auth_id_here
VOBIZ_AUTH_TOKEN=your_vobiz_auth_token_here
VOBIZ_CALLER_ID=+91XXXXXXXXXX
# Public HTTPS URL reachable by Vobiz for webhooks (e.g. ngrok or deployed domain)
VOICE_PUBLIC_BASE_URL=https://your-domain-or-ngrok.dev
DIALER_MAX_LINES=3
DIALER_WEEKLY_CALL_LIMIT=4
DIALER_MIN_CREDIT=0
DIALER_REQUIRE_CONSENT=true

# ===================================================================
# Server & Network Settings
# ===================================================================
HOST=0.0.0.0
PORT=8000
BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ===================================================================
# Database & Cache Settings
# ===================================================================
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/leadcloser
REDIS_URL=redis://localhost:6379/0
DATABASE_PATH=leads_crm.db

# ===================================================================
# Real-time Voice Engine (Pipecat + Sarvam streaming)
# ===================================================================
VOICE_ENGINE=pipecat
VOICE_STT_MODEL=saaras:v3
VOICE_LLM_MODEL=sarvam-105b-conversations
VOICE_TTS_MODEL=bulbul:v4-flash
VOICE_ICE_SERVERS=stun:stun.l.google.com:19302

# ===================================================================
# Optional / Legacy Integrations (Inactive unless explicitly configured)
# ===================================================================
# Twilio (Optional legacy fallback):
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# Exotel (Optional legacy fallback):
# EXOTEL_ACCOUNT_SID=
# EXOTEL_API_KEY=
# EXOTEL_CALLER_ID=
