# ===================================================================
# Sarvam AI API Configuration
# Get your key at: https://sarvam.ai
# ===================================================================
SARVAM_API_KEY=your_sarvam_api_key_here

# ===================================================================
# Server & Network Settings
# ===================================================================
HOST=0.0.0.0
PORT=8000
BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ===================================================================
# Database & Cache Settings
# ===================================================================
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/leadcloser
REDIS_URL=redis://localhost:6379/0
DATABASE_PATH=leads_crm.db


# ===================================================================
# Telephony Integration (Optional - for real outbound mobile calls)
# ===================================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=


# ===================================================================
# Real-time Voice Engine (Pipecat + Sarvam streaming)
# ===================================================================
# pipecat (default) or classic (old /ws/web-call engine)
VOICE_ENGINE=pipecat
VOICE_STT_MODEL=saaras:v3
VOICE_LLM_MODEL=sarvam-105b-conversations
VOICE_TTS_MODEL=bulbul:v4-flash
# Comma-separated STUN/TURN servers for browser calls
VOICE_ICE_SERVERS=stun:stun.l.google.com:19302

# Local development without PostgreSQL:
# DATABASE_URL=sqlite:///./leads_dev.db
