# ===================================================================
# Application Environment & Security
# ===================================================================
# development | production | test
APP_ENV=development
# Cryptographic secret for signing JWT tokens (REQUIRED in production):
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_strong_random_signing_key_here
# Enforce mandatory JWT authentication across all endpoints:
AUTH_STRICT=false

# ===================================================================
# Sarvam AI API Configuration
# Get your key at: https://sarvam.ai
# ===================================================================
SARVAM_API_KEY=your_sarvam_api_key_here

# ===================================================================
# Server & Network Settings
# ===================================================================
HOST=0.0.0.0
PORT=8000
BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ===================================================================
# Database & Cache Settings
# ===================================================================
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/leadcloser
REDIS_URL=redis://localhost:6379/0
DATABASE_PATH=leads_crm.db

# ===================================================================
# Telephony Integration (Optional - for real outbound mobile calls)
# ===================================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ===================================================================
# Real-time Voice Engine (Pipecat + Sarvam streaming)
# ===================================================================
# pipecat (default) or classic (old /ws/web-call engine)
VOICE_ENGINE=pipecat
VOICE_STT_MODEL=saaras:v3
VOICE_LLM_MODEL=sarvam-105b-conversations
VOICE_TTS_MODEL=bulbul:v4-flash
# Comma-separated STUN/TURN servers for browser calls
VOICE_ICE_SERVERS=stun:stun.l.google.com:19302

# Local development without PostgreSQL:
# DATABASE_URL=sqlite:///./leads_dev.db
# Public wss:// base for Vobiz stream URLs if behind a proxy that hides the host (optional)
# VOICE_PUBLIC_WS_BASE=wss://calls.example.com

# ===================================================================
# Outbound Dialer (Phase 0)
# ===================================================================
# vobiz | exotel | fake (simulated phone network for testing). Empty = first configured, else fake
DIALER_PROVIDER=
# Public https base the phone provider can reach (answer/hangup/status callbacks)
VOICE_PUBLIC_BASE_URL=https://your-host
# Simultaneous outbound calls (= phone lines/channels you have)
DIALER_MAX_LINES=3
DIALER_WEEKLY_CALL_LIMIT=4
# Minimum credit balance before dialling (0 = off until billing is live)
DIALER_MIN_CREDIT=0
DIALER_REQUIRE_CONSENT=true

# Vobiz (also numbers rented from Sarvam): Console -> API credentials
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_CALLER_ID=+91XXXXXXXXXX

# Exotel outbound: connect the lead to your Voicebot call flow
EXOTEL_FLOW_URL=http://my.exotel.com/<sid>/exoml/start_voice/<app_id>
